APP_ENV=development
FILMFINDER_ARTIFACTS_DIR=../../packages/recommendation-engine/artifacts
TMDB_METADATA_PATH=../../packages/recommendation-engine/artifacts/tmdb_metadata.json
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=20
MAX_UNCOMPRESSED_SIZE_MB=100
MAX_ZIP_ENTRIES=64
MAX_CONCURRENT_RECOMMENDATIONS=1
TMDB_API_KEY=
TMDB_REQUEST_TIMEOUT=20
FILMFINDER_DB_PATH=var/filmfinder.db
SQLITE_BUSY_TIMEOUT_MS=5000
APP_BASE_URL=http://localhost:3000
EMAIL_BACKEND=console
EMAIL_FROM=noreply@filmfinder.local
EMAIL_FROM_NAME=FilmFinder
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_REQUEST_TIMEOUT=10
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=ff_session
CSRF_COOKIE_NAME=ff_csrf
COOKIE_SECURE=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
SIGNUP_RATE_LIMIT_ATTEMPTS=5
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
EMAIL_RATE_LIMIT_ATTEMPTS=3
EMAIL_RATE_LIMIT_WINDOW_SECONDS=900
REQUIRE_EMAIL_VERIFICATION=false
ANALYTICS_RETENTION_DAYS=365
